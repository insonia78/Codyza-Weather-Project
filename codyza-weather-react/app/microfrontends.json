{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "codyza-weather-project-954u": {
      "packageName": "app",
      "development": {
        "local": 3000,
        "task": "start",
        "fallback": "codyza-weather-project-954u.vercel.app"
      }
    },
    "codyza-weather-project": {
      "packageName": "app",
      "assetPrefix": "codyza-weather-angular-assets",
      "development": {
        "local": 4200,
        "task": "start",
        "fallback": "codyza-weather-project.vercel.app"
      },
      "routing": [
        {
          "paths": [
            "/codyza-weather-angular",
            "/codyza-weather-angular/:path*",
            "/codyza-weather-angular-assets/:path*"
          ]
        }
      ]
    }
  }
}
{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "codyza-weather-project-2tnd": {
      "packageName": "app",
      "development": {
        "local": 3000,
        "task": "start",
        "fallback": "codyza-weather-project-2tnd.vercel.app"
      }
    },
    "codyza-weather-project": {
      "packageName": "app",
      "development": {
        "local": 4200,
        "task": "start",
        "fallback": "codyza-weather-project.vercel.app"
      },
      "routing": [
        {
          "paths": ["/codyza-weather-angular", "/codyza-weather-angular/:path*"]
        }
      ]
    }
  }
}
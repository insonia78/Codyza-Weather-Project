# Codyza Weather shared environment template
# Copy the sections you need into the matching service-local environment file.

# ----------------------------------------------------------------------
# React root auth app: codyza-weather-react/app/.env
# ----------------------------------------------------------------------
REACT_APP_APP_NAME=Codyza Weather
REACT_APP_ENVIRONMENT=production
REACT_APP_API_BASE_URL=https://ywdslwhykwgegkdnhvvi.supabase.co/functions/v1/weather-gateway
REACT_APP_API_KEY=your-supabase-publishable-key
REACT_APP_CODYZA_WEATHER_URL=https://codyza-weather-project-17oc.vercel.app/dashboard
REACT_APP_ADMIN_APP_URL=https://codyza-weather-project-rjf9.vercel.app

# ----------------------------------------------------------------------
# Next.js admin app: codyza-administration-nextjs/administration/.env.local
# ----------------------------------------------------------------------
ADMIN_GATEWAY_BASE_URL=https://ywdslwhykwgegkdnhvvi.supabase.co/functions/v1/weather-gateway
ADMIN_GATEWAY_API_KEY=your-supabase-publishable-key
NEXT_PUBLIC_ROOT_APP_URL=https://codyza-weather-project-17oc.vercel.app

# ----------------------------------------------------------------------
# NestJS weather API: codyza-weatherapi-api-nestjs/app/.env
# ----------------------------------------------------------------------
PORT=3000
GOOGLE_WEATHER_API_KEY=your-google-weather-server-key
GOOGLE_WEATHER_BASE_URL=https://weather.googleapis.com/v1
GOOGLE_GEOCODE_BASE_URL=https://geocode.googleapis.com/v4/geocode
OPENWEATHER_API_KEY=your-openweather-server-key
OPENWEATHER_ONE_CALL_BASE_URL=https://api.openweathermap.org/data/3.0/onecall
OPENWEATHER_AIR_POLLUTION_BASE_URL=https://api.openweathermap.org/data/2.5/air_pollution
OPENWEATHER_TILE_BASE_URL=https://tile.openweathermap.org/map
WEATHER_SEARCH_HISTORY_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
WEATHER_OBSERVABILITY_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
WEATHER_DATABASE_POOL_MAX=6
WEATHER_DATABASE_POOL_IDLE_TIMEOUT_MS=30000
WEATHER_DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
WEATHER_DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
WEATHER_OBSERVABILITY_POOL_MAX=3
WEATHER_OBSERVABILITY_POOL_IDLE_TIMEOUT_MS=30000
WEATHER_OBSERVABILITY_POOL_CONNECTION_TIMEOUT_MS=5000
WEATHER_OBSERVABILITY_POOL_MAX_LIFETIME_SECONDS=1800
WEATHER_GATEWAY_INTERNAL_SECRET=replace-with-shared-gateway-secret

# ----------------------------------------------------------------------
# Python registration API: codyza-weather-registration-api-python/api/v1/.env
# ----------------------------------------------------------------------
POSTGRES_URL=postgresql://postgres:password@host:5432/postgres
POSTGRES_FILE_NAME=postgres
POSTGRES_POOL_SIZE=3
POSTGRES_MAX_OVERFLOW=1
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=replace-with-jwt-secret
JWT_ALGORITHM=HS256
ALLOWED_INBOUND_ORIGINS=https://ywdslwhykwgegkdnhvvi.supabase.co/functions/v1/weather-gateway
WEATHER_GATEWAY_INTERNAL_SECRET=replace-with-shared-gateway-secret
PASSWORD_RESET_URL_BASE=https://codyza-weather-project-17oc.vercel.app/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_DEBUG_LINKS_ENABLED=false
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_FROM_EMAIL=
PASSWORD_RESET_SMTP_FROM_NAME=Codyza Weather
PASSWORD_RESET_SMTP_USE_TLS=true

# ----------------------------------------------------------------------
# Supabase Edge Functions: codyza-supabase-edge-functions/supabase/functions/.env
# ----------------------------------------------------------------------
WEATHER_REGISTRATION_API_URL=https://your-registration-api-host
WEATHER_API_URL=https://your-nest-weather-api-host
JWT_CREATOR_URL=https://your-project.supabase.co/functions/v1/jwt-creator
JWT_VALIDATOR_URL=https://your-project.supabase.co/functions/v1/jwt-validator
JWT_REVOKE_URL=https://your-project.supabase.co/functions/v1/jwt-revoke
WEATHER_GATEWAY_INTERNAL_SECRET=replace-with-shared-gateway-secret
MY_JWT_SECRET=replace-with-custom-jwt-signing-secret
CUSTOM_JWT_SECRET=replace-with-custom-jwt-signing-secret
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
JWT_TOKEN_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
JWT_TOKEN_DATABASE_POOL_MAX=2
JWT_TOKEN_DATABASE_IDLE_TIMEOUT_SECONDS=30
JWT_TOKEN_DATABASE_CONNECT_TIMEOUT_SECONDS=5


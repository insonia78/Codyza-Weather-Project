POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/codyza_weather_registration
POSTGRES_FILE_NAME=codyza_weather_registration
POSTGRES_POOL_SIZE=3
POSTGRES_MAX_OVERFLOW=1
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
WEATHER_GATEWAY_INTERNAL_SECRET=change-me

# Public React reset-password page, for example:
# https://your-auth-app.example.com/reset-password
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# Enable this only for non-production testing if you want the API to return a preview reset link.
PASSWORD_RESET_DEBUG_LINKS_ENABLED=false

# Password reset token lifetime in minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP configuration for live password reset email delivery.
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_FROM_EMAIL=
PASSWORD_RESET_SMTP_FROM_NAME=Codyza Weather
PASSWORD_RESET_SMTP_USE_TLS=true
